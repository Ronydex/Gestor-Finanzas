package com.gestor.controller;

import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.servlet.mvc.support.RedirectAttributes;
import javax.validation.Valid;
import org.springframework.validation.BindingResult;
import org.springframework.security.core.Authentication;
import com.gestor.service.MetaAhorroService;
import com.gestor.dto.MetaAhorroRequestDTO;

@Controller
@RequestMapping("/metas")
public class MetaAhorroController{

    private final MetaAhorroService metAhorroService;

    public MetaAhorroController(MetaAhorroService metAhorroService){
        this.metAhorroService = metAhorroService;
    }
    
    @PostMapping("/guardar")
    public String guardarMeta(@Valid @ModelAttribute("metaAhorro") MetaAhorroRequestDTO metAhorroDTO,
                              BindingResult result, Authentication authentication, RedirectAttributes redirectAttributes)
    {
        if(result.hasErrors()){
        redirectAttributes.addFlashAttribute("error", "Datos de la meta inválidos");
        return "redirect:/dashboard";
        }

        if(result.hasErrors()){
        result.getAllErrors().forEach(error -> System.out.println("ERROR DE VALIDACION: " + error.toString()));

        redirectAttributes.addFlashAttribute("error", "Datos de la meta inválidos");
        return "redirect:/dashboard";
        }
        String email = authentication.getName();
        metAhorroService.guardarOActualizarMeta(metAhorroDTO, email);
        redirectAttributes.addFlashAttribute("exito", "Meta de ahorro procesada correctamente");
        return "redirect:/dashboard";
}

}
